# Export these settings before starting the backend, or use uvicorn --env-file.
KAVACH_MODE=airgapped
KAVACH_INFERENCE_PROVIDER=ollama
# hash = real local lexical retrieval; provider = configured learned encoder.
KAVACH_EMBEDDING_BACKEND=hash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REASONING_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_OTHER_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_TIMEOUT_S=120
KAVACH_MAX_UPLOAD_MB=25
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Absolute paths are recommended for custom storage locations.
# KAVACH_DATA=E:/kavach/data
# KAVACH_UPLOADS=E:/kavach/data/uploads
# KAVACH_GENERATED=E:/kavach/generated
# KAVACH_DB=E:/kavach/data/kavach.db
# Optional text-only Transformers provider; install requirements-transformers.txt.
# KAVACH_INFERENCE_PROVIDER=transformers
# KAVACH_TRANSFORMERS_MODEL_PATH=C:/models/local-instruct-model
# KAVACH_TRANSFORMERS_EMBED_MODEL_PATH=C:/models/local-embedding-model
# KAVACH_TRANSFORMERS_DEVICE=auto
# KAVACH_TRANSFORMERS_MAX_NEW_TOKENS=256
# Local OCR executable is installed separately.
# KAVACH_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
KAVACH_OCR_LANGUAGE=eng
KAVACH_OCR_DPI=200
KAVACH_OCR_REVIEW_MIN_CONFIDENCE=70
# KAVACH_PLANNER_MAX_STEPS=10
# KAVACH_REVIEW_MIN_CONFIDENCE=75
# Real isolated Python execution requires a local Linux Docker engine and runner image.
KAVACH_SANDBOX_ENABLED=true
KAVACH_SANDBOX_IMAGE=kavach-sandbox:1
# Windows WSL engine (generated automatically by scripts/setup-sandbox.ps1):
# KAVACH_SANDBOX_WSL_DISTRO=Ubuntu-24.04
# KAVACH_SANDBOX_DOCKER_HOST=unix:///var/run/docker.sock
KAVACH_SANDBOX_TIMEOUT_S=10
KAVACH_SANDBOX_MEMORY_MB=128
